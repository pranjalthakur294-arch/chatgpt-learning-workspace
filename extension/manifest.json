{
  "manifest_version": 3,
  "name": "AI Learning Workspace",
  "version": "1.0",

  "permissions": [
  "storage",
  "activeTab",
  "scripting",
  "contextMenus"
],

  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["content.js"]
    }
  ],
 "web_accessible_resources": [
  {
    "resources": [
      "dist/*",
      "dist/assets/*"
    ],
    "matches": ["<all_urls>"]
  }
],

  "action": {
    "default_title": "AI Learning Workspace"
  }
}